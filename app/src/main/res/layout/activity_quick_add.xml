<?xml version="1.0" encoding="utf-8"?>
<!-- Root fills the whole opaque window (see Theme.Calendar.QuickAdd) and stands in for what a
     floating dialog window would otherwise give for free: a tap outside the card (handled in
     QuickAddActivity) finishes the activity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickAddRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#2D353B"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/quickAddHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New event today"
                android:textColor="#E9E5D3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- helperTextEnabled/errorEnabled=false so the outlined box doesn't reserve its
                 usual space below the field for text neither is ever shown here — that
                 reserved space plus the 2-line allowance was most of why this field measured
                 well past what one line of text needs. boxCornerRadius matches the buttons
                 below (12dp) instead of Material's own default, so the card doesn't mix three
                 unrelated corner radii. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/quickAddTitleLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title"
                android:textColorHint="#859289"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#7FBBB3"
                app:errorEnabled="false"
                app:helperTextEnabled="false"
                app:hintTextColor="#7FBBB3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/quickAddTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#E9E5D3"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickAddCancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#859289"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/quickAddSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#7FBBB3"
                    android:text="Add"
                    android:textColor="#1E2326" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>
